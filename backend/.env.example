# Copy this file to ".env" and fill in your real values.
# The real ".env" is gitignored and must NEVER be committed.

# Your Nebius Token Factory key. Leave blank to run with deterministic
# explanation fallbacks (no AI calls).
NEBIUS_API_KEY=your_token_here

# OpenAI-compatible base URL and model id for Token Factory. Confirm the model
# id against the live catalog at https://tokenfactory.nebius.com/model-catalog
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3-Super-120b-a12b
